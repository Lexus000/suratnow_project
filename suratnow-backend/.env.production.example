APP_NAME=SuratNow
APP_ENV=production
APP_KEY=generate-a-unique-key-with-php-artisan-key-generate
APP_DEBUG=false
APP_URL=https://suratnow.example.go.id
FRONTEND_URL=https://suratnow.example.go.id

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=suratnow
DB_USERNAME=suratnow_app
DB_PASSWORD=replace-with-a-secret-manager-value

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_EXPIRATION=1440
SANCTUM_STATEFUL_DOMAINS=suratnow.example.go.id
SEED_DEMO_ACCOUNTS=false
CORS_ALLOWED_ORIGINS=https://suratnow.example.go.id
GEMINI_GLOBAL_RATE_LIMIT=120
LETTER_REQUEST_DAILY_LIMIT=100
LETTER_REQUEST_MAX_DATA_BYTES=32768
LETTER_REQUEST_MAX_LIST_ITEMS=500

MAIL_MAILER=smtp
MAIL_HOST=replace-with-smtp-host
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-secret
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.go.id
MAIL_FROM_NAME="SuratNow"
